# Copiez ce fichier vers .env UNIQUEMENT sur alwaysdata ou votre poste local.
# Ne committez jamais le vrai fichier .env.
NODE_ENV=production
SESSION_SECRET=remplacez-par-une-longue-valeur-aleatoire

# PostgreSQL alwaysdata
PGHOST=postgresql-VOTRE_COMPTE.alwaysdata.net
PGPORT=5432
PGDATABASE=VOTRE_COMPTE_inventaire
PGUSER=VOTRE_COMPTE
PGPASSWORD=mot-de-passe-postgresql
PGSSL=false

# Utilisateur créé automatiquement uniquement si la table users est vide.
# Après le premier démarrage réussi, vous pouvez supprimer ADMIN_PASSWORD du .env.
ADMIN_USERNAME=inventaire-admin
ADMIN_PASSWORD=changez-moi-immediatement

# Fuseau utilisé pour l'historique par date.
APP_TIMEZONE=Europe/Paris
